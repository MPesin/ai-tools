{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit|^mcp__",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-guard.sh\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-record.sh\"" }]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "(^|:)dev-(planner|plan-critic|implementer|reviewer|fixer|review-triager|qa-impact)$",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-context.sh\"" }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "(^|:)dev-(planner|plan-critic|implementer|reviewer|fixer|review-triager|qa-impact)$",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-verify-stop.sh\"" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-notify.sh\"" }] }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-session.sh\"" }]
      }
    ]
  }
}
